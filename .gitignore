__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.venv/
venv/
.env
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
# The docker-compose volume lives here and stays ignored, but contributor
# scouting files MUST be tracked - they are the input the site is built from.
# (A plain `data/` exclusion cannot be undone for a child path, hence data/*.)
data/*
!data/captures/
!data/captures/*.json
dist/
build/

# Derived at build time by `owdb contribute merge` from data/captures/.
# Committing it would let a stale report outlive the observations it came from,
# and freeze the analysis that produced it.
owdb_comps.json

# Local dashboard preview. The LIVE site is docs/index.html, built by CI from
# its own synced database; this is built from whatever is on this machine, so
# committing it would put a 3 MB artifact in the repo that can disagree with the
# real page.
dashboard.html
# Same thing, saved under a second name when publishing a preview elsewhere.
dashboard_artifact.html

# runtime
auto-update.log
*.log

# Refs export bundle - regenerated from the local DB with `owdb refs export`.
owdb_refs.zip

# owdb runtime artifacts
calibration/
refs/
screenshots/
overwatch-hero-icons/
*.sqlite3.bak-*

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Capture/calibration debug crops (created at runtime)
crops/

# Visual brainstorming companion scratch files (superpowers:brainstorming)
.superpowers/

# opencode agent workspace (its own plugins + node_modules)
.opencode/

# playwright-core for tools/verify_capture_browser.js. Deliberately NOT a repo
# dependency - it is installed ad hoc to run the browser harness and must never
# be committed (a `git add -A` swept it in once).
/node_modules/

# Agent worktrees are their own git repositories; committing one embeds a repo.
.claude/worktrees/

# OverPy toolchain for the scrim workshop code (tools/scrim_code/)
tools/scrim_code/node_modules/
# Generated paste-ready workshop text (rebuilt via `npm run build`)
tools/scrim_code/scrim_owdb.txt

# tesseract.js for tools/real_frame_eval/. Deliberately NOT a repo dependency -
# the capture page loads tesseract from a CDN at runtime, and this is installed
# ad hoc to run the eval harness. It must never be committed (a `git add -A`
# swept it in once).
/node_modules/
# Tesseract drops its language data in the repo root on first run.
/eng.traineddata

# Agent worktrees are their own git repositories; committing one embeds a repo.
.claude/worktrees/
